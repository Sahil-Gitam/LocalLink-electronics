{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["routes/**", "models/**", "middleware/**", "services/**", "sync/**", "seed/**", "config/**", "docs/**"]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "index.js" }]
}
