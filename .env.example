# ---------------------------------------------------------------------------
# Localink — environment variables
# Copy to .env (frontend, repo root) and backend/.env (API) and fill in.
# ---------------------------------------------------------------------------

# ---- Frontend (repo root / Vercel frontend project) -----------------------
# Full URL of the deployed API, including the /api suffix.
REACT_APP_API_BASE_URL=https://localink-api.vercel.app/api
# Set to 'true' for local dev to proxy /api -> http://localhost:5000 instead.
REACT_APP_API_USE_PROXY=

# ---- Backend (backend/ directory / Vercel API project) --------------------
# REQUIRED — MongoDB Atlas connection string
MONGO_URI=
# REQUIRED — any long random string, used to sign auth tokens
JWT_SECRET=

# Comma-separated list of allowed browser origins. Leave blank to allow all.
CORS_ORIGINS=https://localink-shop.vercel.app

# Seed the product catalogue on first request after deploy.
# Set to 'true' once, redeploy, then set back to 'false'.
SEED_ON_START=false
FORCE_SEED_ON_START=false

# ---- Optional: AI recommendations & vector search -------------------------
# Without these the app falls back to MongoDB-based similarity — everything
# still works, recommendations are just less clever.
SYNC_PINECONE_ON_START=false
GOOGLE_AI_API_KEY=
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=
PINECONE_NAMESPACE=
WEAVIATE_HOST=
WEAVIATE_API_KEY=
